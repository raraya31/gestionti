      "typeVersion": 4.4,
      "position": [1620, 180],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": { "parameters": [ { "name": "anthropic-version", "value": "2023-06-01" }, { "name": "content-type", "value": "application/json" } ] },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.anthropicBody) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "ZlSbBLrOrNxGENjr", "name": "Anthropic API (x-api-key)" }
      }
    },
    {
      "id": "40e6ce31-c521-4726-a5ef-3585d29bc799",
      "name": "Extract Updated Workflow",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1820, 180],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const wfId = $(\"Prepare Modify Prompt\").first().json.workflow_id;\nconst out = [];\nfor (const item of $input.all()) {\n  const raw = (item.json.content && item.json.content[0] && item.json.content[0].text) || \"{}\";\n  let c = String(raw).trim().split(\"```json\").join(\"\").split(\"```\").join(\"\").trim();\n  let wf;\n  try { wf = JSON.parse(c); } catch (e) { throw new Error(\"Claude did not return valid workflow JSON: \" + c.slice(0, 200)); }\n  const putBody = { name: wf.name, nodes: wf.nodes, connections: wf.connections, settings: wf.settings || {} };\n  out.push({ json: { workflow_id: wfId, putBody: putBody } });\n}\nreturn out;"
      }
    },
