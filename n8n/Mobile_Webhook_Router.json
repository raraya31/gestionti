      "position": [-120, 600],
      "webhookId": "9e406b5f-5970-44dc-8b9a-21f9d8ede16b",
      "parameters": {
        "httpMethod": "POST",
        "path": "mobile-router",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "69d18141-c0a4-4da3-8055-a1a5f9fde05d",
      "name": "Normalize Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [100, 600],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "command", "value": "={{ $json.body?.command ?? $json.command ?? \"\" }}", "type": "string" },
            { "id": "a2", "name": "source", "value": "={{ $json.body?.source ?? $json.source ?? \"mobile_voice\" }}", "type": "string" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "84ea8469-5b88-461a-848f-33de35f9df9b",
      "name": "Build Router Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [320, 600],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const SYSTEM_PROMPT = \"You are the intent router for Gestion TI Informatique, a solo MSP automation hub built on n8n, HaloPSA, N-central and Microsoft Graph. You receive a natural-language command transcribed from a phone (voice-to-text). Classify it into EXACTLY ONE of three actions and reply with ONLY a compact minified JSON object: no markdown, no code fences, no prose. Action schemas: (1) MODIFY_WORKFLOW to change an existing n8n workflow, fields {\\\"action\\\":\\\"MODIFY_WORKFLOW\\\",\\\"reasoning\\\":string,\\\"workflow_id\\\":string,\\\"modification_instructions\\\":string}. (2) GENERATE_SCRIPT to author a new automation script, fields {\\\"action\\\":\\\"GENERATE_SCRIPT\\\",\\\"reasoning\\\":string,\\\"script_language\\\":\\\"powershell\\\" or \\\"python\\\",\\\"script_filename\\\":string,\\\"script_content\\\":string}; script_content MUST be the full runnable script; use a .ps1 extension for PowerShell and .py for Python. (3) EXECUTE_API to call HaloPSA or Microsoft Graph, fields {\\\"action\\\":\\\"EXECUTE_API\\\",\\\"reasoning\\\":string,\\\"target_system\\\":\\\"halopsa\\\" or \\\"msgraph\\\",\\\"http_method\\\":\\\"GET\\\" or \\\"POST\\\" or \\\"PATCH\\\" or \\\"PUT\\\" or \\\"DELETE\\\",\\\"endpoint\\\":string absolute URL,\\\"payload\\\":object}. Rules: pick the single best action; always include action and reasoning; include ONLY the fields for the chosen action; endpoint must be an absolute https URL; return valid minified JSON and nothing else. If unsure, choose GENERATE_SCRIPT.\";\nconst out = [];\nfor (const item of $input.all()) {\n  const command = String(item.json.command || \"\");\n  out.push({ json: { command: command, source: item.json.source || \"mobile_voice\", anthropicBody: { model: \"claude-3-5-sonnet-20241022\", max_tokens: 1500, system: SYSTEM_PROMPT, messages: [ { role: \"user\", content: command } ] } } });\n}\nreturn out;"
      }
    },
    {
      "id": "af6e4a39-6f89-4d48-b8ae-6ae858be0bb3",
      "name": "Claude Router (Parse Intent)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [540, 600],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": { "parameters": [ { "name": "anthropic-version", "value": "2023-06-01" }, { "name": "content-type", "value": "application/json" } ] },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.anthropicBody) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "ZlSbBLrOrNxGENjr", "name": "Anthropic API (x-api-key)" }
      }
    },
    {
      "id": "256f202c-3db9-4c73-9976-17902d8a3fd0",
      "name": "Extract Intent",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 600],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const raw = (item.json.content && item.json.content[0] && item.json.content[0].text) || \"{}\";\n  let c = String(raw).trim().split(\"```json\").join(\"\").split(\"```\").join(\"\").trim();\n  let intent;\n  try { intent = JSON.parse(c); } catch (e) { intent = { action: \"UNKNOWN\", reasoning: \"Could not parse Claude output\", raw: c }; }\n  out.push({ json: intent });\n}\nreturn out;"
      }
    },
    {
      "id": "56c9bfe3-4d98-49a0-915f-66df9c23e341",
      "name": "Route Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [980, 600],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [ { "leftValue": "={{ $json.action }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "MODIFY_WORKFLOW" } ], "combinator": "and" }, "renameOutput": true, "outputKey": "MODIFY_WORKFLOW" },
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [ { "leftValue": "={{ $json.action }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "GENERATE_SCRIPT" } ], "combinator": "and" }, "renameOutput": true, "outputKey": "GENERATE_SCRIPT" },
            { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" }, "conditions": [ { "leftValue": "={{ $json.action }}", "operator": { "type": "string", "operation": "equals" }, "rightValue": "EXECUTE_API" } ], "combinator": "and" }, "renameOutput": true, "outputKey": "EXECUTE_API" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "06e9e250-379f-457e-8928-8db19378d147",
      "name": "n8n Get Workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1220, 180],
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.N8N_API_BASE_URL || \"http://localhost:5678\") + \"/api/v1/workflows/\" + $json.workflow_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_WITH_N8N_API_CREDENTIAL", "name": "n8n REST API (X-N8N-API-KEY)" }
      }
    },
    {
      "id": "08da6e9d-9956-490d-870d-a4c18b532c3f",
      "name": "Prepare Modify Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1420, 180],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const SYSTEM_MODIFY = \"You are an n8n workflow engineer. You receive the current workflow JSON and modification instructions. Return ONLY the complete updated workflow JSON object (same object with the requested changes applied). Preserve id, name and structural integrity, keep node connections valid, and output minified JSON only with no markdown and no code fences.\";\nconst intent = $(\"Extract Intent\").first().json;\nconst out = [];\nfor (const item of $input.all()) {\n  const current = item.json;\n  const userMsg = \"Modification instructions: \" + (intent.modification_instructions || \"\") + \" . Current workflow JSON: \" + JSON.stringify(current);\n  out.push({ json: { workflow_id: intent.workflow_id, anthropicBody: { model: \"claude-3-5-sonnet-20241022\", max_tokens: 4096, system: SYSTEM_MODIFY, messages: [ { role: \"user\", content: userMsg } ] } } });\n}\nreturn out;"
      }
    },
